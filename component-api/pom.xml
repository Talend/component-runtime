<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.talend.sdk.component</groupId>
    <artifactId>component-runtime</artifactId>
    <version>1.2611.0-SNAPSHOT</version>
  </parent>

  <artifactId>component-api</artifactId>

  <name>Component API</name>
  <description>Talend Component Kit API</description>

  <properties>
    <talend.build.name>org.talend.sdk.component.api</talend.build.name>
  </properties>

  <dependencies>
    <!-- QTDI-3497 (experimental, jakarta-only spike): replaces the javax geronimo specs with
         their jakarta equivalents - this module's public surface (lifecycle annotations,
         Record/Schema JSON-P/JSON-B types) is now jakarta-only, no javax fallback. This is a
         breaking change for every connector already compiled against the javax line - see the
         ticket for the downstream impact analysis. -->
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.json</groupId>
      <artifactId>jakarta.json-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.json.bind</groupId>
      <artifactId>jakarta.json.bind-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.johnzon</groupId>
      <artifactId>johnzon-jsonb</artifactId>
      <version>${johnzon.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <splitindex>true</splitindex>
          <linksource>true</linksource>
          <windowtitle>${project.name}</windowtitle>
          <header>${project.name} - ${project.version}</header>
          <doctitle>${project.name} - ${project.version}</doctitle>
          <bottom>${project.version} - Copyright &amp;copy; 2022 &lt;a href="https://talend.github.io/component-runtime/" target="_top"&gt;Talend Component Kit Documentation&lt;a&gt;</bottom>
          <use>true</use>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
