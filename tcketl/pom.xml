<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standalone aggregator: intentionally NOT listed in the <modules> of the root pom. Build it from the repository root with "mvn -f tcketl/pom.xml ...". -->
  <parent>
    <groupId>org.talend.sdk.component</groupId>
    <artifactId>component-runtime</artifactId>
    <version>1.2611.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>tcketl-parent</artifactId>
  <packaging>pom</packaging>

  <name>Component Runtime :: TCKETL</name>
  <description>JavaFX design-time ETL pipeline designer built on top of a Talend Component Kit component-server</description>
  <organization>
    <name>Talend</name>
    <url>https://github.com/Talend/component-runtime</url>
  </organization>

  <modules>
    <module>tcketl-domain</module>
    <module>tcketl-persistence</module>
    <module>tcketl-config</module>
    <module>tcketl-component-client</module>
    <module>tcketl-forms-core</module>
    <module>tcketl-forms</module>
    <module>tcketl-forms-vaadin</module>
    <module>tcketl-app-core</module>
    <module>tcketl-app</module>
    <module>tcketl-web</module>
  </modules>

  <properties>
    <talend.build.name>${talend.build.name.base}.tcketl</talend.build.name>

    <!-- JavaFX 21 (LTS) needs JDK 17+. If a JDK specific problem shows up, a 17.0.x version is a drop-in fallback for this property. -->
    <openjfx.version>21.0.2</openjfx.version>
    <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
    <!-- SVG rasterizer for the component icons: Java 8 bytecode, no transitive dependency -->
    <jsvg.version>2.0.0</jsvg.version>

    <!-- the web application: Spring Boot 3.5 and Vaadin 24 LTS need JDK 17 -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- 24.10.8+ requires a commercial license (extended maintenance): stay on the last freely usable patch -->
    <vaadin.version>24.10.7</vaadin.version>
    <tcketl.slf4j.version>2.0.17</tcketl.slf4j.version>
    <tcketl.logback.version>1.5.19</tcketl.logback.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-config</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-persistence</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-component-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-forms</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-forms-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-forms-vaadin</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>${project.groupId}</groupId>
        <artifactId>tcketl-app-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-base</artifactId>
        <version>${openjfx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${openjfx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-fxml</artifactId>
        <version>${openjfx.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.weisj</groupId>
        <artifactId>jsvg</artifactId>
        <version>${jsvg.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>${javafx-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>tcketl-build-from-repository-root</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <!-- the root pom resolves the Spotless formatter files from ${maven.multiModuleProjectDirectory} -->
                <requireFilesExist>
                  <files>
                    <file>${maven.multiModuleProjectDirectory}/build/talend.importorder</file>
                  </files>
                  <message>tcketl must be built from the repository root: mvn -f tcketl/pom.xml &lt;goals&gt;</message>
                </requireFilesExist>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs combine.children="append">
            <!-- keeps modules that only hold package documentation packageable (non-empty jar) -->
            <arg>-Xpkginfo:always</arg>
            <arg>-Xlint:all,-processing</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
