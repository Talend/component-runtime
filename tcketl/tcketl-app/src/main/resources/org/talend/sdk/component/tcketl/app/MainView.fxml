<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.talend.sdk.component.tcketl.app.MainController" styleClass="main-view">
  <top>
    <VBox>
      <MenuBar>
        <menus>
          <Menu text="_File">
            <items>
              <MenuItem fx:id="newItem" text="New pipeline" accelerator="Shortcut+N" onAction="#newPipeline"/>
              <MenuItem fx:id="openItem" text="Open&#8230;" accelerator="Shortcut+O" onAction="#openPipeline"/>
              <MenuItem fx:id="saveItem" text="Save" accelerator="Shortcut+S" onAction="#savePipeline"/>
              <MenuItem fx:id="saveAsItem" text="Save as&#8230;" accelerator="Shortcut+Shift+S"
                        onAction="#savePipelineAs"/>
              <SeparatorMenuItem/>
              <MenuItem text="Connection settings&#8230;" accelerator="Shortcut+Comma"
                        onAction="#openConnectionSettings"/>
              <SeparatorMenuItem/>
              <MenuItem text="Quit" accelerator="Shortcut+Q" onAction="#quit"/>
            </items>
          </Menu>
          <Menu text="_View">
            <items>
              <MenuItem text="Refresh palette" accelerator="F5" onAction="#refreshPalette"/>
              <MenuItem text="Search palette" accelerator="Shortcut+F" onAction="#searchPalette"/>
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <HBox fx:id="banner" styleClass="banner" spacing="10" alignment="CENTER_LEFT">
        <Label fx:id="bannerText" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <Button text="Retry" onAction="#retry"/>
        <Button text="Connection settings&#8230;" onAction="#openConnectionSettings"/>
      </HBox>
    </VBox>
  </top>
  <center>
    <SplitPane dividerPositions="0.2,0.62">
      <StackPane fx:id="paletteHost" styleClass="palette-host" minWidth="200"/>
      <BorderPane fx:id="canvasHost" styleClass="canvas-area" minWidth="320"/>
      <StackPane fx:id="inspectorHost" styleClass="inspector-area" minWidth="300"/>
    </SplitPane>
  </center>
  <bottom>
    <HBox styleClass="status-bar" spacing="12" alignment="CENTER_LEFT">
      <Label fx:id="statusLabel"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="noticeLabel" styleClass="notice"/>
      <Hyperlink fx:id="changedLink" text="The server changed: refresh the palette" onAction="#refreshPalette"/>
    </HBox>
  </bottom>
</BorderPane>
