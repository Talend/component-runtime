<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.StackPane?>

<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.talend.sdk.component.tcketl.app.connection.ConnectionDialogController"
            headerText="Where is the component server?" prefWidth="520" styleClass="connection-dialog">
  <content>
    <GridPane hgap="10" vgap="10" styleClass="connection-form">
      <padding>
        <Insets top="4" bottom="4"/>
      </padding>
      <columnConstraints>
        <ColumnConstraints halignment="RIGHT" minWidth="80"/>
        <ColumnConstraints hgrow="ALWAYS"/>
      </columnConstraints>

      <Label text="Scheme" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
      <ComboBox fx:id="scheme" prefWidth="120" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

      <Label text="Host" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
      <TextField fx:id="host" promptText="localhost" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

      <Label text="Port" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
      <TextField fx:id="port" promptText="8080" maxWidth="100" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

      <Label text="Base path" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
      <TextField fx:id="basePath" promptText="/api/v1" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

      <Label text="Language" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
      <ComboBox fx:id="language" prefWidth="120" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

      <Label text="Address" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
      <Label fx:id="url" styleClass="url" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

      <Button fx:id="testButton" text="Test connection" onAction="#test"
              GridPane.rowIndex="6" GridPane.columnIndex="1"/>

      <!-- a test is forgotten as soon as a field changes, so only one of the two messages is shown at a time;
           the dialog is not resized once shown, so room for three lines is always reserved (see tcketl.css) -->
      <StackPane alignment="TOP_LEFT" styleClass="message-area" GridPane.rowIndex="7" GridPane.columnIndex="1">
        <Label fx:id="testResult" wrapText="true" alignment="TOP_LEFT" maxWidth="Infinity" maxHeight="Infinity"/>
        <Label fx:id="validation" wrapText="true" alignment="TOP_LEFT" maxWidth="Infinity" maxHeight="Infinity"
               styleClass="field-error"/>
      </StackPane>
    </GridPane>
  </content>
</DialogPane>
